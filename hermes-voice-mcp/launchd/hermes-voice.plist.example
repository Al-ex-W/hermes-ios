<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for install.sh, which replaces __UV__, __PROJECT__ and __LOG__. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.hermes-ios.voice</string>
	<key>ProgramArguments</key>
	<array>
		<string>__UV__</string>
		<string>run</string>
		<string>--directory</string>
		<string>__PROJECT__</string>
		<string>hermes-voice-mcp</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
